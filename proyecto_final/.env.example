# Valores públicos; no incluir contraseñas, tokens ni claves.
PSET4_COMPOSE_PROJECT=proyecto-final
PSET4_API_PORT=8004
PSET4_API_IMAGE=proyecto-final-api:local
# Servicio MLflow existente del PSet 03, accesible desde el contenedor.
MLFLOW_TRACKING_URI=http://host.docker.internal:5001
PSET4_MODEL_MODE=mlflow
PSET4_FORCE_FALLBACK=0
# Capacidad y reparto experimentales; no equivalen a fondos institucionales.
PSET4_CAPACITY=0.10
PSET4_WEEK2_SHARE=0.25
PSET4_POLICY_VERSION=preventiva-prototipo-0.1
