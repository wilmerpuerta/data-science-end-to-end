# Valores públicos; no incluir contraseñas, tokens ni claves.
PSET4_COMPOSE_PROJECT=proyecto-final
PSET4_API_PORT=8004
# Copiar el digest mostrado en el resumen de proyecto-final-cd.
# Ejemplo: ghcr.io/wilmerpuerta/oulad-proyecto-final-api@sha256:<digest>
PSET4_API_IMAGE=ghcr.io/wilmerpuerta/oulad-proyecto-final-api@sha256:ee4e0da32b14bb5254463229dd40c31483118ef57360657a84ece166cff4b9f6
# Clientes del host; API y monitor usan http://mlflow:5000 en la red interna.
PSET4_MLFLOW_PORT=5004
MLFLOW_TRACKING_URI=http://127.0.0.1:5004
PSET4_MODEL_MODE=mlflow
PSET4_FORCE_FALLBACK=0
# Capacidad y reparto experimentales; no equivalen a fondos institucionales.
PSET4_CAPACITY=0.10
PSET4_WEEK2_SHARE=0.25
PSET4_POLICY_VERSION=preventiva-prototipo-0.1
# Completar solo en .env privado antes de levantar Kestra.
PSET4_KESTRA_PORT=8094
PSET4_KESTRA_MANAGEMENT_PORT=8095
PSET4_POSTGRES_PASSWORD=
PSET4_KESTRA_PASSWORD=
SNOWFLAKE_CONNECTION_HOST_PATH=/ruta/privada/snowflake_connection.json
SNOWFLAKE_PRIVATE_KEY_HOST_PATH=/ruta/privada/snowflake_key.p8

PSET4_API_DERIVA_PORT=8006
PSET4_TABLERO_PORT=8504

# Datos originales con manifest.json; directorio montado de solo lectura.
OULAD_DATA_DIR=../datasets
# Generar localmente: python3 -c "import secrets; print(secrets.token_hex(32))"
PSET4_INGESTA_TOKEN=
