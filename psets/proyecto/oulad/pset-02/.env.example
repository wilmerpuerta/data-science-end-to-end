# Plantilla pública: ejemplos ficticios; nunca copiar valores privados aquí.
# Infraestructura local: preparar_infra.py genera estos campos en .env.infra.
PSET2_POSTGRES_PASSWORD=EJEMPLO_NO_UTILIZAR
PSET2_KESTRA_PASSWORD=EJEMPLO_NO_UTILIZAR
# Ruta resuelta desde pset-02/ por Compose.
OULAD_DATA_DIR=../datasets
# Aislamiento opcional para reproducciones locales; defaults del proyecto principal.
PSET2_COMPOSE_PROJECT_NAME=pset2
PSET2_KESTRA_PORT=8080
PSET2_KESTRA_MANAGEMENT_PORT=8081
# Referencias ficticias para clientes; el cargador Raw usa el JSON privado.
SNOWFLAKE_ACCOUNT=organizacion-cuenta-ejemplo
SNOWFLAKE_USER=USUARIO_EJEMPLO
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_ROLE=PSET2_PIPELINE
SNOWFLAKE_WAREHOUSE=PSET2_WH
SNOWFLAKE_DATABASE=PSET2_OULAD
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_OBT_SCHEMA=ANALYTICS
# Rutas ficticias para los montajes del override cloud.
SNOWFLAKE_CONNECTION_HOST_PATH=/ruta/local/fuera-del-repositorio/pset2-connection.json
SNOWFLAKE_PRIVATE_KEY_HOST_PATH=/ruta/local/fuera-del-repositorio/rsa_key.p8
# La frase se guarda solo en el JSON privado fuera del repositorio, no en este archivo.
# Conexiones host/Kestra/dbt/Spark verificadas; secretos fuera de archivos versionados.
